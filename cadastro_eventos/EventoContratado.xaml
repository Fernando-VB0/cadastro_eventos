<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="cadastro_eventos.EventoContratado"
             Shell.NavBarIsVisible="False"
             Title="Resumo do Evento">

    <VerticalStackLayout Spacing="15" Padding="20">

        <Label Text="Resumo do Evento Cadastrado" 
               FontSize="22" 
               FontAttributes="Bold" 
               HorizontalOptions="Center"/>


        <Label Text="{Binding NomeEvento, StringFormat='Nome: {0}'}" FontSize="18" />

        <Label Text="{Binding LocalEvento, StringFormat='Local: {0}'}" FontSize="18" />

        <Label Text="{Binding NumeroParticipantes, StringFormat='Participantes: {0}'}" FontSize="18" />

        <Label Text="{Binding CustoPorParticipante, StringFormat='Custo por Pessoa: {0:C}'}" FontSize="18" />

        <Label Text="{Binding DataInicio, StringFormat='Início: {0:dd/MM/yyyy}'}" FontSize="18" />

        <Label Text="{Binding DataTermino, StringFormat='Término: {0:dd/MM/yyyy}'}" FontSize="18" />

        <Label Text="{Binding DuracaoDias, StringFormat='Duração: {0} dias'}" FontSize="18" FontAttributes="Bold" />

        <Label Text="{Binding CustoTotal, StringFormat='Custo Total do Evento: {0:C}'}" 
               FontSize="20" 
               FontAttributes="Bold" 
               TextColor="Green" />

    </VerticalStackLayout>
</ContentPage>